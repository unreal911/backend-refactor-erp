NODE_ENV=production
PORT=3000
PUBLIC_PATH=public
DATABASE_URL=postgresql://runtime_role:PASSWORD@POOL_HOST/DB?sslmode=require&connect_timeout=10&pool_timeout=10
DIRECT_DATABASE_URL=postgresql://migration_role:PASSWORD@DIRECT_HOST/DB?sslmode=require&connect_timeout=10
JWT_SECRET=
CORS_ORIGINS=https://admin.example.com,https://tienda.example.com
CLOUD_MODE=aws
AWS_REGION=us-east-1
SUNAT_DOCUMENT_STORAGE_ENABLED=true
SUNAT_LEGACY_BASE64_FALLBACK_ENABLED=true
SUNAT_KMS_SECRETS_ENABLED=true
SUNAT_S3_BUCKET=
SUNAT_S3_KMS_KEY_ID=
SUNAT_KMS_KEY_ID=
S3_FORCE_PATH_STYLE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OWNER_SIGNUP_ENABLED=false
TENANT_INVITATION_ENABLED=false
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_TOKEN_PEPPER=
PASSWORD_RESET_URL=https://admin.example.com/forgot-password/reset
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
BILLING_WEBHOOK_ENABLED=false
BILLING_WEBHOOK_SECRET=
TRIAL_EXPORT_URL=https://admin.example.com/admin/empresa
SEED_ENDPOINT_ENABLED=false
SEED_INCLUDE_DEMO_USERS=false
SEED_INCLUDE_PRODUCTS=false
# OPS-002: reemplazar por el canal de guardia real de preproduccion/produccion.
OPS_ALERT_CHANNEL=REPLACE_ME
TENANT_EXPORT_MAX_BYTES=104857600
TENANT_PURGE_BATCH_SIZE=500
