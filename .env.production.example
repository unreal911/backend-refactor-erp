# ==========================================================================
#  BACKEND — ENTORNO DE PRODUCCIÓN (Railway)
# --------------------------------------------------------------------------
#  Estas son las variables para COMPLETAR al desplegar en Railway.
#  Cárgalas como variables/secretos del servicio backend.
#  NO subas este archivo con valores reales a git.
# ==========================================================================

# --- App ---
NODE_ENV=production
# PORT lo asigna Railway automáticamente; no hace falta definirlo.
PUBLIC_PATH=public

# --- Base de datos compartida en Neon ---
DATABASE_URL=

# --- Seguridad ---
# Secreto fuerte y único. Genera con:  openssl rand -base64 48
JWT_SECRET=
# Clave independiente (32+ bytes aleatorios) para HMAC de tokens de registro.
OWNER_SIGNUP_TOKEN_PEPPER=
# Clave distinta (32+ bytes aleatorios) para huellas antiabuso no reversibles.
OWNER_SIGNUP_ABUSE_PEPPER=
# Clave distinta para HMAC de invitaciones de colaboradores.
TENANT_INVITATION_TOKEN_PEPPER=
# Orígenes permitidos (coma-separado): proyectos Vercel productivos.
CORS_ORIGINS=https://admin.example.com,https://tienda.example.com

# --- Registro de propietarios (EMP-001) ---
# Mantener apagado hasta configurar y probar el proveedor SMTP.
OWNER_SIGNUP_ENABLED=false
OWNER_SIGNUP_VERIFY_URL=https://admin.example.com/signup/verify
OWNER_SIGNUP_TERMS_VERSION=2026-08-01
OWNER_SIGNUP_TOKEN_TTL_MINUTES=30
OWNER_TRIAL_TOKEN_TTL_MINUTES=1440
OWNER_SIGNUP_IP_LIMIT=5
OWNER_SIGNUP_IP_WINDOW_MINUTES=60
OWNER_SIGNUP_EMAIL_LIMIT=3
OWNER_SIGNUP_EMAIL_WINDOW_MINUTES=1440
OWNER_SIGNUP_DEVICE_LIMIT=3
OWNER_SIGNUP_DEVICE_WINDOW_MINUTES=1440
# Cloudflare Turnstile: la site key se configura en el frontend; este secreto
# solo vive en el backend. Usa widgets separados para staging y producción.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=admin.example.com
TURNSTILE_EXPECTED_ACTION=owner_signup
TURNSTILE_TIMEOUT_MS=5000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Invitaciones de colaboradores (EMP-005) ---
TENANT_INVITATION_ENABLED=false
TENANT_INVITATION_ACCEPT_URL=https://admin.example.com/accept-invitation
TENANT_INVITATION_TTL_HOURS=72

# --- Cloudinary (imágenes) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed: endurecido para producción (dejar así) ---
SEED_ENDPOINT_ENABLED=false
SEED_TRIGGER_KEY=
SEED_INCLUDE_DEMO_USERS=false
SEED_INCLUDE_PRODUCTS=false
SEED_DEMO_PASSWORD=unused_in_production

# --- Admin inicial (lo crea bootstrap:admin en el primer arranque) ---
SEED_ADMIN_EMAIL=admin@tu-empresa.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Principal
SEED_ADMIN_RESET_PASSWORD=false

# ==========================================================================
#  SUNAT — Producción
# --------------------------------------------------------------------------
#  En prod los datos del emisor (RUC, certificado .pfx, Clave SOL) se cargan
#  CIFRADOS desde el dashboard, no por env. Aquí solo va la llave maestra.
# ==========================================================================
# Llave AES-256-GCM heredada para leer secretos SUNAT v1 durante la migración.
# Genera con:  openssl rand -base64 32
# ⚠️ Debe ser FIJA. Si la cambias, los secretos ya guardados se vuelven ilegibles.
SUNAT_CONFIG_ENC_KEY=

# ==========================================================================
#  AWS S3/KMS — Producción
# --------------------------------------------------------------------------
#  CLOUD_MODE=moto está prohibido cuando NODE_ENV=production.
#  AWS_ENDPOINT_URL debe permanecer vacío para usar endpoints oficiales.
# ==========================================================================
# Activar solo al desplegar la gestión documental SUNAT. Al quedar en true, el
# backend aborta antes de consultar PostgreSQL si esta configuración es insegura.
SUNAT_DOCUMENT_STORAGE_ENABLED=false
CLOUD_MODE=aws
AWS_ENDPOINT_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SUNAT_S3_BUCKET=
SUNAT_KMS_KEY_ID=
SUNAT_S3_KMS_KEY_ID=
