# RENDER TEST — API TENANT + WORKER DRAIN
# Guía completa y origen de cada valor: ../CONFIGURACION_ENTORNOS.md
# No colocar secretos reales en este archivo ni en Git.

# ============================================================================
# 1. OBLIGATORIO PARA ARRANCAR
# ============================================================================
NODE_ENV=production
PUBLIC_PATH=public

# Render PostgreSQL > Connect > Internal Database URL para DATABASE_URL.
# Para migraciones usa un usuario con permisos DDL en DIRECT_DATABASE_URL.
DATABASE_URL=postgresql://runtime_role:CLAVE@HOST/DB?sslmode=require
DIRECT_DATABASE_URL=postgresql://migration_role:CLAVE@HOST/DB?sslmode=require

# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generar_48_bytes_base64url

# URLs de los frontends que podrán llamar a la API, separadas por coma.
CORS_ORIGINS=https://admin-test.onrender.com,https://marketplace-test.onrender.com,https://web-test.onrender.com

# Cloudinary > Settings > API Keys. Actualmente son obligatorias al arrancar.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ============================================================================
# 2. EMAIL CON RESEND (SMTP OFICIAL)
# ============================================================================
# Resend > Domains: verificar un dominio o subdominio.
# Resend > API Keys: crear una key "Sending access" limitada a ese dominio.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=re_TU_API_KEY_DE_ENVIO
SMTP_FROM=Tienda <no-reply@emails.tudominio.com>

OWNER_SIGNUP_ENABLED=true
OWNER_SIGNUP_VERIFY_URL=https://admin-test.onrender.com/signup/verify
OWNER_SIGNUP_TERMS_VERSION=2026-08-01
OWNER_SIGNUP_TOKEN_PEPPER=generar_48_bytes_base64url
OWNER_SIGNUP_ABUSE_PEPPER=generar_otro_secreto_48_bytes_base64url
OWNER_SIGNUP_TOKEN_TTL_MINUTES=30
OWNER_TRIAL_TOKEN_TTL_MINUTES=1440

TENANT_INVITATION_ENABLED=true
TENANT_INVITATION_ACCEPT_URL=https://admin-test.onrender.com/accept-invitation
TENANT_INVITATION_TOKEN_PEPPER=generar_48_bytes_base64url
TENANT_INVITATION_TTL_HOURS=72

PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_URL=https://admin-test.onrender.com/forgot-password/reset
PASSWORD_RESET_TOKEN_PEPPER=generar_48_bytes_base64url
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
TRIAL_EXPORT_URL=https://admin-test.onrender.com/admin/empresa

# Turnstile: Cloudflare Dashboard > Turnstile > tu widget > Secret Key.
# En pruebas controladas puede quedar vacío; limita el registro público.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=admin-test.onrender.com
TURNSTILE_EXPECTED_ACTION=owner_signup

# ============================================================================
# 3. WHATSAPP CLOUD API
# ============================================================================
# Estas credenciales sólo provisionan WhatsApp. Los canales permitidos para
# cada flujo se controlan exclusivamente en Superadmin > Canales de acceso.

# Meta for Developers > tu app > WhatsApp > Configuración de la API. Es una
# versión elegida por compatibilidad, no una credencial.
WHATSAPP_API_VERSION=v25.0

# Meta Business Suite > Configuración del negocio > Usuarios > Usuarios del
# sistema: crea uno, asígnale app y cuenta WhatsApp, y genera el token
# permanente con business_management, whatsapp_business_messaging y
# whatsapp_business_management. No uses el token temporal de "Pruebas de API".
# Es un secreto: guárdalo sólo en las variables protegidas de Render.
WHATSAPP_ACCESS_TOKEN=TOKEN_PERMANENTE_DE_META

# Meta Business Suite > WhatsApp Manager > Números de teléfono: abre el
# emisor y copia "Identificador del número de teléfono"; no es el +51 visible.
WHATSAPP_PHONE_NUMBER_ID=ID_DEL_NUMERO_DE_WHATSAPP

# WhatsApp Manager > Herramientas de la cuenta > Plantillas de mensajes:
# crea, aprueba y copia nombre e idioma exactos. Cada plantilla debe tener
# {{1}} para recibir el enlace del flujo.
WHATSAPP_VERIFICATION_TEMPLATE_NAME=owner_signup_verification
WHATSAPP_VERIFICATION_TEMPLATE_LANGUAGE=es
WHATSAPP_INVITATION_TEMPLATE_NAME=tenant_invitation
WHATSAPP_INVITATION_TEMPLATE_LANGUAGE=es
WHATSAPP_PASSWORD_RESET_TEMPLATE_NAME=password_reset
WHATSAPP_PASSWORD_RESET_TEMPLATE_LANGUAGE=es
WHATSAPP_AUTH_CODE_TTL_MINUTES=10
WHATSAPP_AUTH_CODE_MAX_ATTEMPTS=5

# Valor interno elegido por el proyecto: espera máxima a Meta en milisegundos.
WHATSAPP_TIMEOUT_MS=10000

# Interruptor interno. Actívalo tras validar en Meta el callback HTTPS público:
# https://<tu-dominio-api>/api/public/whatsapp/webhook
WHATSAPP_WEBHOOK_ENABLED=false

# Lo creas tú y lo repites en Meta for Developers > tu app > WhatsApp >
# Configuración > Webhook > Verificar token. No es ACCESS_TOKEN ni el PIN.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=TOKEN_DE_VERIFICACION_WEBHOOK

# Meta for Developers > tu app > Configuración de la app > Básica >
# "Clave secreta de la app" > Mostrar.
WHATSAPP_APP_SECRET=SECRETO_DE_LA_APP_META

# Embedded Signup por empresa. Genera una clave distinta a las demás.
META_APP_ID=ID_DE_LA_APP_META
META_APP_SECRET=SECRETO_DE_LA_APP_META
META_WHATSAPP_CONFIG_ID=ID_DE_CONFIGURACION_EMBEDDED_SIGNUP
WHATSAPP_CONNECTION_ENC_KEY=GENERAR_32_BYTES_EN_BASE64

# Interruptor interno: false conserva la simulación; true activa Meta para la
# empresa indicada, una vez que webhook y credenciales estén listos.
WHATSAPP_ATTENTION_ENABLED=false

# UUID interno de Tenant.id, no un ID de Meta. Se obtiene de la respuesta de
# Superadmin /api/platform/tenants o de PostgreSQL; debe poseer este número.
WHATSAPP_ATTENTION_TENANT_ID=UUID_DE_LA_EMPRESA_QUE_USA_ESTE_NUMERO

# ============================================================================
# 4. SEGURIDAD Y OPERACIÓN
# ============================================================================
# Generar Base64 de 32 bytes; no cambiar después de guardar constancias.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_PROOF_ENC_KEY=generar_32_bytes_base64
SUNAT_CONFIG_ENC_KEY=generar_otro_valor_32_bytes_base64

SEED_ENDPOINT_ENABLED=false
SEED_INCLUDE_DEMO_USERS=false
SEED_INCLUDE_PRODUCTS=false
API_INSTANCE_COUNT=1
REALTIME_REDIS_URL=
BILLING_WEBHOOK_ENABLED=false
BILLING_WEBHOOK_SECRET=

# Sentry > Project Settings > Client Keys (DSN). Vacío = desactivado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=render-test
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Worker continuo: start:worker. Cron de prueba: start:worker:drain.
WORKER_POLL_MS=2000
WORKER_DRAIN_MAX_JOBS=50
SUNAT_TICKET_POLL_SECONDS=120

# ============================================================================
# 4. AWS S3 + KMS — OPCIONAL DURANTE LA PRUEBA
# ============================================================================
# Para probar Render sin AWS, mantener los tres flags siguientes así.
CLOUD_MODE=aws
SUNAT_DOCUMENT_STORAGE_ENABLED=false
SUNAT_KMS_SECRETS_ENABLED=false
SUNAT_LEGACY_BASE64_FALLBACK_ENABLED=true

# Al activar AWS, crear bucket S3 privado, una KMS key y credenciales IAM de
# mínimo privilegio. No usar credenciales root. Vacíos mientras esté desactivado.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false
SUNAT_S3_BUCKET=
SUNAT_S3_KMS_KEY_ID=
SUNAT_KMS_KEY_ID=

# Imágenes comerciales S3 son opcionales y usan bucket separado del de SUNAT.
PRODUCT_IMAGE_S3_BUCKET=
PRODUCT_IMAGE_S3_PUBLIC_BASE_URL=

# ============================================================================
# 5. SUNAT BETA — SOLO SI SE PROBARÁ FACTURACIÓN
# ============================================================================
SUNAT_RUC=20100066603
SUNAT_RAZON_SOCIAL=EMISOR DEMO SAC
SUNAT_UBIGEO=150101
SUNAT_BETA_SOL_USER=MODDATOS
SUNAT_BETA_SOL_PASSWORD=MODDATOS
SUNAT_BETA_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_ALLOW_TEST_CERT=true
SUNAT_SIGNATURE_ID=SignSUNAT

TENANT_EXPORT_MAX_BYTES=104857600
TENANT_PURGE_BATCH_SIZE=500
OPS_ALERT_CHANNEL=render-test-console
