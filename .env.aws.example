# Configuracion no secreta para el proveedor de imagenes de staging en AWS.
# En ECS, la API recibe credenciales temporales mediante su task role IAM.
# No agregar AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY al contenedor.
CLOUD_MODE=aws
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false
PRODUCT_IMAGE_PROVIDER=S3

# Bucket privado de imagenes comerciales; el navegador solo accede por CloudFront.
PRODUCT_IMAGE_S3_BUCKET=proyecto-tienda-product-images-staging-277522752013-us-east-1
PRODUCT_IMAGE_S3_PUBLIC_BASE_URL=https://d2w79e1a81pz4d.cloudfront.net

# El bucket SUNAT es un recurso separado; configura sus variables en el entorno
# de ECS desde Secrets Manager / parametros validados del despliegue existente.
