# ==========================================================================
#  BACKEND — ENTORNO DE PRUEBAS / DESARROLLO LOCAL
# --------------------------------------------------------------------------
#  Copia este archivo a  .env  y ajusta lo que necesites.
#  Valores pensados para correr local + SUNAT en BETA (no producción).
#  Para producción usa  .env.production.example
# ==========================================================================

# --- App ---
NODE_ENV=development
PORT=3000
PUBLIC_PATH=public

# --- Base de datos (Postgres local) ---
DATABASE_URL=postgresql://postgres:MySecr3tPassWord%40as2@localhost:5432/tienda_dbt

# --- Seguridad ---
JWT_SECRET=replace_with_a_strong_secret
PLATFORM_MFA_REQUIRED=false
# Base64 de 32 bytes. Obligatoria en producción; no reutilizar SUNAT_CONFIG_ENC_KEY.
PLATFORM_MFA_ENC_KEY=
PAYMENT_PROOF_ENC_KEY=
REALTIME_REDIS_URL=
API_INSTANCE_COUNT=1
PLATFORM_MFA_ISSUER=Tienda ERP Plataforma
PLATFORM_ADMIN_EMAIL=admin@example.com
# CORS: vacío = permite todos (cómodo en local). En prod restríngelo.
CORS_ORIGINS=

# --- Observabilidad (Sentry) ---
# Vacío = deshabilitado. Usa el mismo DSN en API, worker y scheduler.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# 0 captura errores sin trazas de rendimiento y evita consumo innecesario.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Registro e invitaciones contra Mailpit local ---
OWNER_SIGNUP_ENABLED=true
OWNER_SIGNUP_TOKEN_PEPPER=local-owner-signup-token-pepper-change-me
OWNER_SIGNUP_ABUSE_PEPPER=local-owner-signup-abuse-pepper-change-me
OWNER_SIGNUP_VERIFY_URL=http://localhost:3001/signup/verify
OWNER_SIGNUP_TERMS_VERSION=2026-08-01
# Limites amplios para pruebas manuales locales. Produccion usa los defaults
# estrictos o valores definidos expresamente en su gestor de secretos.
OWNER_SIGNUP_IP_LIMIT=100
OWNER_SIGNUP_IP_WINDOW_MINUTES=60
OWNER_SIGNUP_EMAIL_LIMIT=20
OWNER_SIGNUP_EMAIL_WINDOW_MINUTES=60
OWNER_SIGNUP_DEVICE_LIMIT=50
OWNER_SIGNUP_DEVICE_WINDOW_MINUTES=60
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TENANT_INVITATION_ENABLED=true
TENANT_INVITATION_TOKEN_PEPPER=local-tenant-invitation-pepper-change-me
TENANT_INVITATION_ACCEPT_URL=http://localhost:3001/accept-invitation
TENANT_INVITATION_TTL_HOURS=72
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Tienda local <no-reply@local.test>
PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_TOKEN_PEPPER=local-password-reset-token-pepper-change-me
PASSWORD_RESET_URL=http://localhost:3001/forgot-password/reset
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
TRIAL_EXPORT_URL=http://localhost:3001/admin/empresa

# --- Cloudinary (imágenes) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Seed / datos demo (OK activarlos en local) ---
SEED_ENDPOINT_ENABLED=true
SEED_TRIGGER_KEY=define_if_you_need_manual_seed_key
SEED_INCLUDE_DEMO_USERS=true
SEED_INCLUDE_PRODUCTS=true
SEED_DEMO_PASSWORD=password123
SEED_ADMIN_EMAIL=admin@dominio.com
SEED_ADMIN_PASSWORD=supersegura
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Principal
SEED_ADMIN_RESET_PASSWORD=false

# ==========================================================================
#  SUNAT — Facturación electrónica en BETA (pruebas)
# --------------------------------------------------------------------------
#  En BETA el emisor se puede configurar por estas env (fallback).
#  En PRODUCCIÓN NO: los datos reales del emisor (RUC, certificado, Clave SOL)
#  se cargan cifrados desde el dashboard; solo hace falta SUNAT_CONFIG_ENC_KEY.
# ==========================================================================
# Llave maestra para cifrar/descifrar secretos SUNAT en la BD (AES-256-GCM).
# Genérala con:  openssl rand -base64 32
# NO la cambies una vez guardados secretos (los vuelve irrecuperables).
SUNAT_CONFIG_ENC_KEY=

# Emisor de pruebas (RUC de la documentación oficial SUNAT).
SUNAT_RUC=20100066603
SUNAT_RAZON_SOCIAL=EMISOR DEMO SAC
SUNAT_UBIGEO=150101

# Clave SOL de beta (usuario/clave estándar de pruebas).
SUNAT_BETA_SOL_USER=MODDATOS
SUNAT_BETA_SOL_PASSWORD=MODDATOS
SUNAT_BETA_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService

# Firma: en beta no exige certificado real; autofirma con cert de prueba.
SUNAT_ALLOW_TEST_CERT=true
SUNAT_SIGNATURE_ID=SignSUNAT

# ==========================================================================
#  AWS LOCAL — Moto S3/KMS
# --------------------------------------------------------------------------
#  Inicia con: docker compose up -d moto
#  Inicializa bucket/key con: npm run cloud:local:init
#  Solo datos ficticios. Moto no es almacenamiento ni bóveda productiva.
# ==========================================================================
# La preproducción local valida SUN-001/SUN-002 contra Moto con datos ficticios.
SUNAT_DOCUMENT_STORAGE_ENABLED=true
SUNAT_LEGACY_BASE64_FALLBACK_ENABLED=true
SUNAT_KMS_SECRETS_ENABLED=true
CLOUD_MODE=moto
AWS_ENDPOINT_URL=http://127.0.0.1:5000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
SUNAT_S3_BUCKET=sunat-dev
PRODUCT_IMAGE_S3_BUCKET=product-images-dev
# Dominio público o CDN para objetos comerciales; nunca usar el bucket SUNAT.
PRODUCT_IMAGE_S3_PUBLIC_BASE_URL=http://127.0.0.1:5000/product-images-dev
SUNAT_KMS_KEY_ID=alias/sunat-dev
# En Moto queda vacío. En AWS será obligatorio para SSE-KMS de S3.
SUNAT_S3_KMS_KEY_ID=
# OPS-002: canal de alertas; usar el destino real de guardia fuera de local.
OPS_ALERT_CHANNEL=preproduction-console

# Limites defensivos para exportacion y purga de trials.
TENANT_EXPORT_MAX_BYTES=104857600
TENANT_PURGE_BATCH_SIZE=500
