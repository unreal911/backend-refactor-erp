# RAILWAY — API TENANT Y WORKER CONTINUO
# Guía: ../CONFIGURACION_ENTORNOS.md
# En Railway se pegan como Variables; `${{...}}` son referencias entre servicios.

NODE_ENV=production
PUBLIC_PATH=public
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Para pruebas puede apuntar al mismo Postgres. En producción usar rol DDL separado.
DIRECT_DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=generar_48_bytes_base64url
CORS_ORIGINS=https://admin.example.com,https://marketplace.example.com,https://web.example.com

CLOUDINARY_CLOUD_NAME=Cloudinary_Dashboard
CLOUDINARY_API_KEY=Cloudinary_Dashboard
CLOUDINARY_API_SECRET=Cloudinary_Dashboard

# Resend por SMTP.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=re_TU_API_KEY_DE_ENVIO
SMTP_FROM=Tienda <no-reply@emails.tudominio.com>

OWNER_SIGNUP_ENABLED=true
OWNER_SIGNUP_VERIFY_URL=https://admin.example.com/signup/verify
OWNER_SIGNUP_TERMS_VERSION=2026-08-01
OWNER_SIGNUP_TOKEN_PEPPER=generar_48_bytes_base64url
OWNER_SIGNUP_ABUSE_PEPPER=generar_otro_secreto_48_bytes_base64url
TENANT_INVITATION_ENABLED=true
TENANT_INVITATION_ACCEPT_URL=https://admin.example.com/accept-invitation
TENANT_INVITATION_TOKEN_PEPPER=generar_48_bytes_base64url
PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_URL=https://admin.example.com/forgot-password/reset
PASSWORD_RESET_TOKEN_PEPPER=generar_48_bytes_base64url
TRIAL_EXPORT_URL=https://admin.example.com/admin/empresa
TURNSTILE_SECRET_KEY=Cloudflare_Turnstile_Secret_Key
TURNSTILE_EXPECTED_HOSTNAMES=admin.example.com

PAYMENT_PROOF_ENC_KEY=generar_32_bytes_base64
SUNAT_CONFIG_ENC_KEY=generar_otro_valor_32_bytes_base64
SEED_ENDPOINT_ENABLED=false
SEED_INCLUDE_DEMO_USERS=false
SEED_INCLUDE_PRODUCTS=false
REALTIME_REDIS_URL=${{Redis.REDIS_URL}}
API_INSTANCE_COUNT=1
WORKER_POLL_MS=2000
SUNAT_TICKET_POLL_SECONDS=120

SENTRY_DSN=
SENTRY_ENVIRONMENT=railway
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# AWS opcional. Mantener desactivado hasta crear S3/KMS/IAM.
CLOUD_MODE=aws
SUNAT_DOCUMENT_STORAGE_ENABLED=false
SUNAT_KMS_SECRETS_ENABLED=false
SUNAT_LEGACY_BASE64_FALLBACK_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SUNAT_S3_BUCKET=
SUNAT_S3_KMS_KEY_ID=
SUNAT_KMS_KEY_ID=
PRODUCT_IMAGE_S3_BUCKET=
PRODUCT_IMAGE_S3_PUBLIC_BASE_URL=

TENANT_EXPORT_MAX_BYTES=104857600
TENANT_PURGE_BATCH_SIZE=500
OPS_ALERT_CHANNEL=railway-console
