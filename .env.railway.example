# =============================================================================
# RAILWAY — API TENANT + WORKER PERMANENTE
# =============================================================================
# Esta plantilla NO contiene secretos reales y sí puede permanecer en Git.
# Los valores se cargan en Railway > servicio > Variables.
#
# Servicios previstos dentro del mismo proyecto Railway:
#   1. Postgres: base de datos administrada por Railway.
#   2. API: usa railway.api.toml y ejecuta `npm start`.
#   3. Worker: usa railway.worker.toml y ejecuta `npm run start:worker`.
#
# Para la primera prueba es más sencillo copiar estas variables tanto a la API
# como al worker. No configures Cron Schedule en el worker: debe quedar activo.
# Railway inyecta PORT automáticamente; no agregues PORT manualmente.
# Guía general: ../CONFIGURACION_ENTORNOS.md

# =============================================================================
# 1. EJECUCIÓN
# =============================================================================
NODE_ENV=production
PUBLIC_PATH=public

# =============================================================================
# 2. POSTGRESQL — OBLIGATORIO
# =============================================================================
# Crea un servicio PostgreSQL llamado "Postgres" dentro del mismo proyecto.
# `${{Postgres.DATABASE_URL}}` es una referencia privada de Railway: no debes
# copiar ni publicar la contraseña de la base de datos.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# En pruebas puede usar la misma conexión. En producción conviene separar un
# usuario de migraciones con permisos DDL del usuario usado por la aplicación.
DIRECT_DATABASE_URL=${{Postgres.DATABASE_URL}}

# Solo la API ejecuta `npm run release` antes del deploy. Ese comando aplica las
# migraciones y asegura el administrador configurado en la sección 10.

# =============================================================================
# 3. SEGURIDAD INTERNA — OBLIGATORIO
# =============================================================================
# Generar cada secreto por separado:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=GENERAR_SECRETO_BASE64URL_DE_48_BYTES

# Los peppers deben ser distintos entre sí y no deben cambiarse después de
# emitir tokens que todavía deban seguir siendo válidos.
OWNER_SIGNUP_TOKEN_PEPPER=GENERAR_SECRETO_DISTINTO_DE_48_BYTES
OWNER_SIGNUP_ABUSE_PEPPER=GENERAR_OTRO_SECRETO_DISTINTO_DE_48_BYTES
TENANT_INVITATION_TOKEN_PEPPER=GENERAR_OTRO_SECRETO_DISTINTO_DE_48_BYTES
PASSWORD_RESET_TOKEN_PEPPER=GENERAR_OTRO_SECRETO_DISTINTO_DE_48_BYTES

# Claves Base64 de exactamente 32 bytes:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PAYMENT_PROOF_ENC_KEY cifra comprobantes de pagos manuales.
# SUNAT_CONFIG_ENC_KEY mantiene compatibilidad con secretos SUNAT heredados;
# no reutilices la misma clave para ambos propósitos.
PAYMENT_PROOF_ENC_KEY=GENERAR_BASE64_DE_32_BYTES
SUNAT_CONFIG_ENC_KEY=GENERAR_OTRO_BASE64_DE_32_BYTES

# =============================================================================
# 4. FRONTENDS, CORS Y ENLACES DE EMAIL — OBLIGATORIO
# =============================================================================
# Reemplaza las URLs cuando Vercel entregue los dominios definitivos.
# CORS_ORIGINS acepta varias URLs separadas por comas y sin `/` final.
CORS_ORIGINS=https://admin-tu-proyecto.vercel.app,https://marketplace-tu-proyecto.vercel.app,https://web-tu-proyecto.vercel.app

# Estos enlaces se insertan en los emails. Deben apuntar al frontend admin.
OWNER_SIGNUP_VERIFY_URL=https://admin-tu-proyecto.vercel.app/signup/verify
TENANT_INVITATION_ACCEPT_URL=https://admin-tu-proyecto.vercel.app/accept-invitation
PASSWORD_RESET_URL=https://admin-tu-proyecto.vercel.app/forgot-password/reset
TRIAL_EXPORT_URL=https://admin-tu-proyecto.vercel.app/admin/empresa

# =============================================================================
# 5. REGISTRO, INVITACIONES Y RECUPERACIÓN
# =============================================================================
OWNER_SIGNUP_ENABLED=true
OWNER_SIGNUP_TERMS_VERSION=2026-08-01
OWNER_SIGNUP_TOKEN_TTL_MINUTES=30
OWNER_TRIAL_TOKEN_TTL_MINUTES=1440

TENANT_INVITATION_ENABLED=true
TENANT_INVITATION_TTL_HOURS=72

PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# Turnstile es opcional durante una prueba controlada. Si habilitas registros
# públicos, crea un widget en Cloudflare Turnstile y coloca su Secret Key.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=admin-tu-proyecto.vercel.app
TURNSTILE_EXPECTED_ACTION=owner_signup

# =============================================================================
# 6. GMAIL SMTP — EMAILS DE PRUEBA
# =============================================================================
# Usa una cuenta Gmail exclusiva para pruebas con verificación en dos pasos.
# SMTP_PASSWORD debe ser una Contraseña de aplicación de Google, NO la
# contraseña normal de Gmail. Guárdala solo en Railway y sin espacios.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta-pruebas@gmail.com
SMTP_PASSWORD=CONTRASENA_DE_APLICACION_GOOGLE_DE_16_CARACTERES
SMTP_FROM=Tienda Pruebas <tu-cuenta-pruebas@gmail.com>

# =============================================================================
# 7. CLOUDINARY — IMÁGENES COMERCIALES
# =============================================================================
# Obtener en Cloudinary Dashboard > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
CLOUDINARY_API_KEY=TU_API_KEY
CLOUDINARY_API_SECRET=TU_API_SECRET

# =============================================================================
# 8. AWS S3 + KMS — CONFIGURACIÓN EXISTENTE
# =============================================================================
# Reutiliza los recursos AWS ya creados. No generes buckets, claves KMS ni
# credenciales IAM nuevos. Guarda las credenciales únicamente en Railway.
CLOUD_MODE=aws
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=TU_ACCESS_KEY_ID_EXISTENTE
AWS_SECRET_ACCESS_KEY=TU_SECRET_ACCESS_KEY_EXISTENTE

# En AWS real el endpoint queda vacío y path-style debe permanecer desactivado.
AWS_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false

# Documentos SUNAT privados (XML, ZIP, CDR y PDF) y cifrado de secretos.
SUNAT_DOCUMENT_STORAGE_ENABLED=true
SUNAT_KMS_SECRETS_ENABLED=true
SUNAT_LEGACY_BASE64_FALLBACK_ENABLED=true
SUNAT_S3_BUCKET=TU_BUCKET_SUNAT_EXISTENTE

# Usa los identificadores o ARN de las claves existentes. Pueden ser la misma
# clave KMS si así fue diseñada la configuración, pero se declaran por separado
# porque cumplen funciones distintas.
SUNAT_S3_KMS_KEY_ID=TU_KMS_KEY_ID_PARA_S3
SUNAT_KMS_KEY_ID=TU_KMS_KEY_ID_PARA_SECRETOS

# Opcional: las imágenes continúan en Cloudinary mientras estos valores estén
# vacíos. Solo configurarlos si ya existe un bucket comercial separado.
PRODUCT_IMAGE_S3_BUCKET=
PRODUCT_IMAGE_S3_PUBLIC_BASE_URL=

# =============================================================================
# 9. WORKER PERMANENTE — SERVICIO SIN DOMINIO PÚBLICO
# =============================================================================
# El worker usa `npm run start:worker` y consulta la cola cada 2 segundos.
# No configurar un horario cron en Railway para este servicio.
WORKER_POLL_MS=2000
SUNAT_TICKET_POLL_SECONDS=120

# =============================================================================
# 10. ADMINISTRADOR INICIAL — RECOMENDADO EN EL PRIMER DEPLOY
# =============================================================================
# `npm run release` crea o actualiza este administrador. Después del primer
# acceso puedes retirar SEED_ADMIN_PASSWORD de Railway si ya no ejecutarás un
# reset. Nunca guardes una contraseña real en este archivo de ejemplo.
SEED_ADMIN_EMAIL=admin-pruebas@tu-dominio-o-gmail.com
SEED_ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA_EN_RAILWAY
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Pruebas
SEED_ADMIN_RESET_PASSWORD=false

# Mantener desactivada la creación de contenido demo en la base remota.
SEED_ENDPOINT_ENABLED=false
SEED_INCLUDE_DEMO_USERS=false
SEED_INCLUDE_PRODUCTS=false

# =============================================================================
# 11. REDIS Y ESCALADO — OPCIONAL
# =============================================================================
# Para una sola instancia puede quedar vacío. Si agregas un servicio Redis
# llamado "Redis", reemplaza la línea vacía por:
# REALTIME_REDIS_URL=${{Redis.REDIS_URL}}
REALTIME_REDIS_URL=
API_INSTANCE_COUNT=1

# =============================================================================
# 12. SENTRY — OPCIONAL
# =============================================================================
# Obtener DSN en Sentry > Project Settings > Client Keys. Vacío = desactivado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=railway-test
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# =============================================================================
# 13. WEBHOOK DE FACTURACIÓN — DESACTIVADO DURANTE LAS PRUEBAS
# =============================================================================
BILLING_WEBHOOK_ENABLED=false
BILLING_WEBHOOK_SECRET=

# =============================================================================
# 14. LÍMITES OPERATIVOS
# =============================================================================
TENANT_EXPORT_MAX_BYTES=104857600
TENANT_PURGE_BATCH_SIZE=500

# Sin integración externa, las alertas quedan visibles en los logs de Railway.
OPS_ALERT_CHANNEL=railway-console
